# Hotspot Environment Configuration

# Core settings
SECRET_KEY=hotspot-secure-local-secret-key-32chars
SITE_URL=http://localhost:8000
DEBUG=1

# Telemetry: completely disabled
OPT_OUT_CAPTURE=true
TELEMETRY_ENABLED=false
OTEL_SDK_DISABLED=true

# Database (Postgres)
DATABASE_URL=postgres://posthog:posthog@db:5432/posthog
PGHOST=db
PGUSER=posthog
PGPASSWORD=posthog

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_DATABASE=posthog
CLICKHOUSE_SECURE=false

# Redis
REDIS_URL=redis://redis7:6379/

# Kafka
KAFKA_HOSTS=kafka:9092

# Object storage (SeaweedFS)
OBJECT_STORAGE_ENDPOINT=http://objectstorage:19000
OBJECT_STORAGE_ACCESS_KEY_ID=object_storage_root_user
OBJECT_STORAGE_SECRET_ACCESS_KEY=object_storage_root_password
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Hotspot Image
HOTSPOT_IMAGE=posthog/posthog:latest

# Hotspot product settings (see products/hotspot/README.md)
# Comma-separated keys the capture endpoint accepts. Leave empty locally to accept any key.
HOTSPOT_API_KEYS=hs_demo
# Password for /dashboard/ and the dashboard API. Leave empty to keep the dashboard open (local only).
HOTSPOT_DASHBOARD_PASSWORD=
# Signs the dashboard cookie; falls back to SECRET_KEY.
HOTSPOT_SECRET_KEY=
# Event names that count as a conversion (default: $form_submit). Write a leading dollar as $$ here, e.g. $$form_submit,signup.
HOTSPOT_CONVERSION_EVENTS=
# Session replay: set 0 to refuse DOM recordings. Each session keeps up to this many compressed bytes.
HOTSPOT_REPLAY_ENABLED=1
HOTSPOT_MAX_RECORDING_BYTES=10485760
